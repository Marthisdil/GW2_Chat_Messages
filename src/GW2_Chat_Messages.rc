#include "resource.h"
#include "Version.h"
#include <winres.h>

// Quick Access (Nexus bar) icons. Regenerate with tools\draw_chat_icon.ps1.
IDB_ICON        PNG "..\\resources\\icons\\icon.png"
IDB_ICON_HOVER  PNG "..\\resources\\icons\\icon_hover.png"

// Shown in the DLL's Properties > Details. The numbers are YYYY, MM, DD, HHMM (GMT).
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CHATMSG_VER_YEAR, CHATMSG_VER_MONTH, CHATMSG_VER_DAY, CHATMSG_VER_TIME
 PRODUCTVERSION CHATMSG_VER_YEAR, CHATMSG_VER_MONTH, CHATMSG_VER_DAY, CHATMSG_VER_TIME
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Marthisdil"
            VALUE "FileDescription",  "Chat Messages (Nexus addon for Guild Wars 2)"
            VALUE "FileVersion",      CHATMSG_VER_TEXT
            VALUE "InternalName",     "GW2_Chat_Messages"
            VALUE "OriginalFilename", "GW2_Chat_Messages.dll"
            VALUE "ProductName",      "Chat Messages"
            VALUE "ProductVersion",   CHATMSG_VER_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
